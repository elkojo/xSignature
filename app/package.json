{
  "name": "xsignature",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fonts:vendor": "node scripts/vendor-fonts.mjs",
    "dump:type": "vite-node scripts/dump-type-svg.ts",
    "dump:draw": "vite-node scripts/dump-draw-svg.ts",
    "check:png": "echo \"npm run dev, then open http://localhost:5173/scripts/png-check.html and read the console\"",
    "dump:stamp": "vite-node scripts/dump-stamp-pdf.ts"
  },
  "devDependencies": {
    "@expo-google-fonts/allura": "^0.4.2",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/great-vibes": "^0.4.1",
    "@expo-google-fonts/mr-de-haviland": "^0.4.1",
    "@expo-google-fonts/parisienne": "^0.4.1",
    "@expo-google-fonts/sacramento": "^0.4.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.20.2",
    "@types/opentype.js": "^1.3.10",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.0",
    "asn1js": "^3.0.10",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "^6.3.289",
    "pkijs": "^3.4.0",
    "signature_pad": "^5.1.4"
  }
}
